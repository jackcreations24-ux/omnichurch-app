{
  "name": "react-example",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win --x64",
    "build:exe:x64": "vite build && electron-builder --win --x64",
    "build:exe:ia32": "vite build && electron-builder --win --ia32",
    "build:exe:both": "vite build && electron-builder --win --x64 --ia32",
    "dist:win": "vite build && electron-builder --win nsis --x64 --ia32",
    "package:win": "vite build && electron-builder --win nsis --x64 --ia32",
    "electron:dev": "vite build && electron electron/main.cjs",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap open android",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "clean": "rm -rf dist dist_electron server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/runTests.ts"
  },
  "build": {
    "appId": "com.zoutiw.omnichurch",
    "productName": "OmniChurch Pro",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "icon": "electron/icon.png",
    "artifactName": "${productName} v${version} Setup (${arch}).${ext}",
    "win": {
      "icon": "electron/icon.png",
      "artifactName": "${productName} v${version} Setup (${arch}).${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniChurch Pro v${version}",
      "artifactName": "${productName} v${version} Setup (${arch}).${ext}"
    }
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/share": "^8.0.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "react-is": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@codetrix-studio/capacitor-google-auth": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
